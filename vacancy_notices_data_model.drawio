<mxfile host="app.diagrams.net" type="device"><diagram id="model" name="Vacancy Notices Data Model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Vacancy Notices Data Model&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;SYSPER HR data platform · Gold layer (lh_hrt_gold) · status 30 September 2026&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="-20" width="700" height="60" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue = fact table · Green = dimension · Orange dashed = planned&lt;br&gt;PK = primary key · FK = link to another table · grey italic = technical, hidden from report users&lt;br&gt;Solid line = active relationship · grey dashed = inactive (used on demand) · orange dashed = planned&lt;br&gt;All relationships are many-to-one, filtering from dimension to fact. Hover a field for its description." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fillColor=#f4f6f9;strokeColor=#dbe1e8;spacing=10;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="1060" width="330" height="140" as="geometry"/></mxCell><mxCell id="c3" value="dim_job&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#555555&quot;&gt;Dimension · One row per post&lt;/font&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;align=left;spacingLeft=8;fillColor=#e5f1ec;strokeColor=#2f6b57;strokeWidth=1.5;rounded=1;arcSize=4;fontFamily=Courier New;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="320" he